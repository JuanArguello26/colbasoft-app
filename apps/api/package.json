{
  "name": "@colbasoft/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p .",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p . --noEmit",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "excel": "tsx scripts/generar-excel.ts",
    "seed": "tsx --env-file=.env scripts/cargar-excel.ts",
    "test": "vitest run",
    "db:test:reset": "tsx --env-file=.env scripts/reiniciar-bd-pruebas.ts"
  },
  "dependencies": {
    "@colbasoft/shared": "*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^6.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
