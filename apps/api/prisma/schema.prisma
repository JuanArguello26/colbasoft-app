// Esquema del corte C1 (bloques C1-1 a C1-3). Se amplía por bloques.
// Entidades del dominio: E-01 Referencia, E-02 SKU, E-03 Categoría, E-04 Lote, E-05 Bodega, E-06 Zona, E-07 Ubicación,
// E-09 Identificador QR, E-10 Movimiento (kardex), E-11 Documento de entrada, E-19 Usuario, E-27 Pieza.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  JEFE_BODEGA
  COORDINADOR_BODEGA
  AUXILIAR_BODEGA
  AUDITOR
}

enum UnidadMedida {
  UNIDADES
  METROS
  ROLLOS
  KILOGRAMOS
}

enum ActorTipo {
  USUARIO
  SISTEMA
}

/// CD-36: el motivo tipificado es obligatorio en ajustes, anulaciones, salidas y descartes de alerta.
enum TipoOperacion {
  AJUSTE
  ANULACION
  SALIDA
  DESCARTE_ALERTA
}

/// RF-QRC-004: el identificador de ubicación es distinguible del de mercancía.
enum IdentificadorTipo {
  MERCANCIA
  UBICACION
}

enum IdentificadorEstado {
  ACTIVO
  ANULADO
}

/// SM-08 (el estado «Reversado» no tiene requisito, HD-19, y no se implementa).
enum EstadoDocumentoEntrada {
  PENDIENTE_RECEPCION
  RECEPCION_PARCIAL
  RECIBIDO_CONFORME
  RECIBIDO_CON_NOVEDAD
  CONFIRMADO
}

/// F-1: rollo (metros, kilogramos o rollos) o paquete/bolsa (unidades). El contenedor agrupado es HU-ENT-010, fuera del corte C1.
enum TipoPieza {
  ROLLO
  PAQUETE
  BOLSA
}

/// Tipos de movimiento del corte C1. Ajuste, salida y anulación llegan con sus bloques.
enum TipoMovimiento {
  ENTRADA
  MOVIMIENTO_INTERNO
}

/// SM-06 (porción de existencia). Reservado, en tránsito e inmovilizado llegan con sus bloques.
enum EstadoExistencia {
  EN_RECEPCION
  DISPONIBLE
}

/// RF-QRC-009 / VO-40: cómo se identificó la mercancía o la ubicación en un movimiento.
enum ModoIdentificacion {
  ESCANEO
  MANUAL
}

enum ZonaTipo {
  RECEPCION
  ALMACENAMIENTO
  PREPARACION_SALIDA
  CUARENTENA
}

model Usuario {
  id           String   @id @default(uuid())
  login        String   @unique
  nombre       String
  passwordHash String
  rol          Rol
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  /// RF-ACC-004: intentos fallidos consecutivos; al llegar al límite configurado la cuenta se bloquea.
  intentosFallidos Int     @default(0)
  bloqueado        Boolean @default(false)
  /// HU-USR-001 criterio 5: el usuario nuevo debe cambiar su contraseña en el primer acceso.
  debeCambiarClave Boolean @default(false)
}

/// Valor modificado de un parámetro de configuración (M-19). Sin fila, rige el valor por defecto de la definición.
model Parametro {
  clave          String   @id
  valor          Float
  actualizadoEn  DateTime @default(now())
  actualizadoPor String?
}

/// Motivo tipificado (CD-36). Nunca se elimina: se desactiva (RN-063).
model Motivo {
  id             String        @id @default(uuid())
  tipoOperacion  TipoOperacion
  nombre         String
  exigeEvidencia Boolean       @default(false)
  activo         Boolean       @default(true)

  @@unique([tipoOperacion, nombre])
}

/// Bitácora de auditoría (AG-16). Inmutable: la base de datos rechaza UPDATE, DELETE y TRUNCATE (RN-061).
/// Cada registro encadena el hash del anterior; toda discontinuidad es un hallazgo crítico.
model RegistroBitacora {
  seq          BigInt    @id @default(autoincrement())
  instante     DateTime
  actorTipo    ActorTipo
  usuarioId    String?
  usuarioLogin String?
  modulo       String
  evento       String
  entidad      String?
  entidadId    String?
  detalle      Json?
  origen       String?
  hashAnterior String
  hash         String

  @@index([instante])
  @@index([modulo])
  @@index([evento])
  @@index([usuarioId])
}

model Categoria {
  id          String       @id @default(uuid())
  nombre      String       @unique
  activa      Boolean      @default(true)
  referencias Referencia[]
  zonas       Zona[]
}

/// RN-MAE-001: el código de referencia es único en todo el catálogo (activa o inactiva).
model Referencia {
  id           String       @id @default(uuid())
  codigo       String       @unique
  descripcion  String
  categoriaId  String
  categoria    Categoria    @relation(fields: [categoriaId], references: [id])
  unidadMedida UnidadMedida
  activa       Boolean      @default(true)
  skus         Sku[]
}

model Talla {
  id     String @id @default(uuid())
  nombre String @unique
  skus   Sku[]
}

model Color {
  id     String @id @default(uuid())
  nombre String @unique
  skus   Sku[]
}

/// SKU = Referencia + Talla + Color, irrepetible (CD-05).
model Sku {
  id           String     @id @default(uuid())
  referenciaId String
  referencia   Referencia @relation(fields: [referenciaId], references: [id])
  tallaId      String
  talla        Talla      @relation(fields: [tallaId], references: [id])
  colorId      String
  color        Color      @relation(fields: [colorId], references: [id])

  lotes         Lote[]
  lineasEntrada LineaEntrada[]

  @@unique([referenciaId, tallaId, colorId])
}

/// HU-LOT-001: todo ingreso queda asociado a un lote. RN-MAE-006: el código de lote es único dentro de su SKU.
model Lote {
  id            String         @id @default(uuid())
  skuId         String
  sku           Sku            @relation(fields: [skuId], references: [id])
  codigo        String
  /// Procedencia de la mercancía (texto libre hasta que existan los documentos de entrada, C1-3).
  origen        String
  fechaIngreso  DateTime       @default(now())
  identificador Identificador?
  lineasEntrada LineaEntrada[]

  @@unique([skuId, codigo])
}

/// RN-IDE-002: ningún identificador se repite jamás, ni tras su anulación. La base de datos rechaza DELETE y
/// cualquier UPDATE que no sea el cambio de estado (migración c1_2_identificacion).
/// DF5-01: el QR de mercancía identifica SKU + Lote (no ubicación ni cantidad). Un identificador es de mercancía (lote)
/// o de ubicación, nunca de ambas cosas.
model Identificador {
  id          String              @id @default(uuid())
  /// Valor que lleva el QR: COL-M-… (mercancía) o COL-U-… (ubicación).
  codigo      String              @unique
  tipo        IdentificadorTipo
  estado      IdentificadorEstado @default(ACTIVO)
  loteId      String?             @unique
  lote        Lote?               @relation(fields: [loteId], references: [id])
  ubicacionId String?             @unique
  ubicacion   Ubicacion?          @relation(fields: [ubicacionId], references: [id])
  creadoEn    DateTime            @default(now())
}

model Bodega {
  id          String             @id @default(uuid())
  codigo      String             @unique
  nombre      String
  zonas       Zona[]
  ubicaciones Ubicacion[]
  entradas    DocumentoEntrada[]
}

model Zona {
  id          String      @id @default(uuid())
  bodegaId    String
  bodega      Bodega      @relation(fields: [bodegaId], references: [id])
  codigo      String
  nombre      String
  tipo        ZonaTipo
  /// RN-MOV-001 / H-19: criterio «zona por categoría» de la propuesta de ubicación. Sin categoría, la zona no se propone por este criterio.
  categoriaId String?
  categoria   Categoria?  @relation(fields: [categoriaId], references: [id])
  ubicaciones Ubicacion[]

  @@unique([bodegaId, codigo])
}

/// RN-MAE-005 / RN-014: el código de ubicación es único dentro de la bodega.
model Ubicacion {
  id              String          @id @default(uuid())
  bodegaId        String
  bodega          Bodega          @relation(fields: [bodegaId], references: [id])
  zonaId          String
  zona            Zona            @relation(fields: [zonaId], references: [id])
  codigo          String
  activa          Boolean         @default(true)
  /// HU-BOD-002: capacidad en una unidad configurada. Sin capacidad = ilimitada y pendiente de configurar (HD-17 abierta).
  capacidad       Float?
  unidadCapacidad UnidadMedida?
  identificador   Identificador?
  asientos        AsientoKardex[]

  @@unique([bodegaId, codigo])
}

/// E-11. No es una orden de compra (DC-03): no lleva precio ni condiciones comerciales (RF-ENT-002).
model DocumentoEntrada {
  id                      String                 @id @default(uuid())
  /// Consecutivo legible (ENT-0001). El identificador interno es `id`.
  numero                  Int                    @unique @default(autoincrement())
  bodegaId                String
  bodega                  Bodega                 @relation(fields: [bodegaId], references: [id])
  origen                  String
  fechaEsperada           DateTime               @db.Date
  estado                  EstadoDocumentoEntrada @default(PENDIENTE_RECEPCION)
  creadoPorId             String
  creadoEn                DateTime               @default(now())
  /// RF-ENT-017: instante en que llegó la mercancía (primera pieza registrada).
  llegadaEn               DateTime?
  /// El Jefe autoriza el sobrante antes de confirmar (RN-ENT-005).
  sobranteAutorizadoPorId String?
  sobranteAutorizadoEn    DateTime?
  confirmadoPorId         String?
  confirmadoEn            DateTime?
  /// Ubicación de recepción donde quedó la existencia al confirmar (RN-EXI-007).
  ubicacionRecepcionId    String?
  lineas                  LineaEntrada[]
  movimientos             Movimiento[]

  @@index([estado])
}

/// Una línea por SKU. El lote se asigna al confirmar la entrada (HU-LOT-001): por eso es opcional hasta entonces.
model LineaEntrada {
  id               String           @id @default(uuid())
  documentoId      String
  documento        DocumentoEntrada @relation(fields: [documentoId], references: [id])
  skuId            String
  sku              Sku              @relation(fields: [skuId], references: [id])
  cantidadEsperada Decimal          @db.Decimal(14, 3)
  /// HU-ENT-004 criterio 5: diferencia (recibido - esperado) registrada al cerrar la recepción.
  diferencia       Decimal?         @db.Decimal(14, 3)
  loteId           String?
  lote             Lote?            @relation(fields: [loteId], references: [id])
  piezas           Pieza[]

  @@unique([documentoId, skuId])
}

/// E-27. Cantidad propia registrada al recibir; no cambia: lo que queda de ella lo dicen los asientos del kardex (RN-LOT-007).
/// Nunca se elimina (RN-MAE-007). El QR no la identifica: identifica su SKU + Lote (DF5-01).
model Pieza {
  id              String          @id @default(uuid())
  /// Consecutivo legible (P-000123): identidad interna de la pieza.
  numero          Int             @unique @default(autoincrement())
  lineaId         String
  linea           LineaEntrada    @relation(fields: [lineaId], references: [id])
  tipo            TipoPieza
  cantidad        Decimal         @db.Decimal(14, 3)
  registradaPorId String
  registradaEn    DateTime        @default(now())
  asientos        AsientoKardex[]

  @@index([lineaId])
}

/// E-10. Hecho que altera la existencia o la ubicación; su conjunto ordenado es el kardex (CD-37).
/// Inmutable: la base rechaza UPDATE, DELETE y TRUNCATE (RN-INT-002). Un error se corrige con otro movimiento.
model Movimiento {
  id                   String              @id @default(uuid())
  /// Orden del kardex.
  secuencia            Int                 @unique @default(autoincrement())
  tipo                 TipoMovimiento
  documentoEntradaId   String?
  documentoEntrada     DocumentoEntrada?   @relation(fields: [documentoEntradaId], references: [id])
  usuarioId            String
  usuarioLogin         String
  /// RF-KDX-009: instante de inicio y de confirmación.
  iniciadoEn           DateTime
  confirmadoEn         DateTime            @default(now())
  modoIdentificacion   ModoIdentificacion?
  /// RN-MOV-003 / RF-BOD-009: ubicación propuesta por el sistema y si el Auxiliar ubicó en otra.
  propuestaUbicacionId String?
  desviacion           Boolean             @default(false)
  asientos             AsientoKardex[]

  @@index([documentoEntradaId])
}

/// Una fila del kardex: lo que un movimiento suma o resta a una pieza en una ubicación y estado.
/// La existencia es SIEMPRE la suma de estos asientos (RN-INT-004); no se guarda en otra parte.
/// La base rechaza que la suma de una pieza en una ubicación y estado quede negativa (RN-EXI-001).
model AsientoKardex {
  id           String           @id @default(uuid())
  movimientoId String
  movimiento   Movimiento       @relation(fields: [movimientoId], references: [id])
  piezaId      String
  pieza        Pieza            @relation(fields: [piezaId], references: [id])
  ubicacionId  String
  ubicacion    Ubicacion        @relation(fields: [ubicacionId], references: [id])
  estado       EstadoExistencia
  delta        Decimal          @db.Decimal(14, 3)

  @@index([piezaId, ubicacionId, estado])
  @@index([ubicacionId])
  @@index([movimientoId])
}
