// Esquema del corte C1 (bloques C1-1 Fundación y C1-2 Identificación y lotes). Se amplía por bloques.
// Entidades del dominio: E-01 Referencia, E-02 SKU, E-03 Categoría, E-05 Bodega, E-06 Zona, E-07 Ubicación, E-19 Usuario, Lote, Identificador.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  JEFE_BODEGA
  COORDINADOR_BODEGA
  AUXILIAR_BODEGA
  AUDITOR
}

enum UnidadMedida {
  UNIDADES
  METROS
  ROLLOS
  KILOGRAMOS
}

enum ActorTipo {
  USUARIO
  SISTEMA
}

/// CD-36: el motivo tipificado es obligatorio en ajustes, anulaciones, salidas y descartes de alerta.
enum TipoOperacion {
  AJUSTE
  ANULACION
  SALIDA
  DESCARTE_ALERTA
}

/// RF-QRC-004: el identificador de ubicación es distinguible del de mercancía.
enum IdentificadorTipo {
  MERCANCIA
  UBICACION
}

enum IdentificadorEstado {
  ACTIVO
  ANULADO
}

enum ZonaTipo {
  RECEPCION
  ALMACENAMIENTO
  PREPARACION_SALIDA
  CUARENTENA
}

model Usuario {
  id           String   @id @default(uuid())
  login        String   @unique
  nombre       String
  passwordHash String
  rol          Rol
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  /// RF-ACC-004: intentos fallidos consecutivos; al llegar al límite configurado la cuenta se bloquea.
  intentosFallidos Int     @default(0)
  bloqueado        Boolean @default(false)
  /// HU-USR-001 criterio 5: el usuario nuevo debe cambiar su contraseña en el primer acceso.
  debeCambiarClave Boolean @default(false)
}

/// Valor modificado de un parámetro de configuración (M-19). Sin fila, rige el valor por defecto de la definición.
model Parametro {
  clave         String   @id
  valor         Float
  actualizadoEn DateTime @default(now())
  actualizadoPor String?
}

/// Motivo tipificado (CD-36). Nunca se elimina: se desactiva (RN-063).
model Motivo {
  id            String        @id @default(uuid())
  tipoOperacion TipoOperacion
  nombre        String
  exigeEvidencia Boolean      @default(false)
  activo        Boolean       @default(true)

  @@unique([tipoOperacion, nombre])
}

/// Bitácora de auditoría (AG-16). Inmutable: la base de datos rechaza UPDATE, DELETE y TRUNCATE (RN-061).
/// Cada registro encadena el hash del anterior; toda discontinuidad es un hallazgo crítico.
model RegistroBitacora {
  seq          BigInt    @id @default(autoincrement())
  instante     DateTime
  actorTipo    ActorTipo
  usuarioId    String?
  usuarioLogin String?
  modulo       String
  evento       String
  entidad      String?
  entidadId    String?
  detalle      Json?
  origen       String?
  hashAnterior String
  hash         String

  @@index([instante])
  @@index([modulo])
  @@index([evento])
  @@index([usuarioId])
}

model Categoria {
  id          String       @id @default(uuid())
  nombre      String       @unique
  activa      Boolean      @default(true)
  referencias Referencia[]
}

/// RN-MAE-001: el código de referencia es único en todo el catálogo (activa o inactiva).
model Referencia {
  id           String       @id @default(uuid())
  codigo       String       @unique
  descripcion  String
  categoriaId  String
  categoria    Categoria    @relation(fields: [categoriaId], references: [id])
  unidadMedida UnidadMedida
  activa       Boolean      @default(true)
  skus         Sku[]
}

model Talla {
  id     String @id @default(uuid())
  nombre String @unique
  skus   Sku[]
}

model Color {
  id     String @id @default(uuid())
  nombre String @unique
  skus   Sku[]
}

/// SKU = Referencia + Talla + Color, irrepetible (CD-05).
model Sku {
  id           String     @id @default(uuid())
  referenciaId String
  referencia   Referencia @relation(fields: [referenciaId], references: [id])
  tallaId      String
  talla        Talla      @relation(fields: [tallaId], references: [id])
  colorId      String
  color        Color      @relation(fields: [colorId], references: [id])

  lotes        Lote[]

  @@unique([referenciaId, tallaId, colorId])
}

/// HU-LOT-001: todo ingreso queda asociado a un lote. RN-MAE-006: el código de lote es único dentro de su SKU.
model Lote {
  id            String         @id @default(uuid())
  skuId         String
  sku           Sku            @relation(fields: [skuId], references: [id])
  codigo        String
  /// Procedencia de la mercancía (texto libre hasta que existan los documentos de entrada, C1-3).
  origen        String
  fechaIngreso  DateTime       @default(now())
  identificador Identificador?

  @@unique([skuId, codigo])
}

/// RN-IDE-002: ningún identificador se repite jamás, ni tras su anulación. La base de datos rechaza DELETE y
/// cualquier UPDATE que no sea el cambio de estado (migración c1_2_identificacion).
/// DF5-01: el QR de mercancía identifica SKU + Lote (no ubicación ni cantidad). Un identificador es de mercancía (lote)
/// o de ubicación, nunca de ambas cosas.
model Identificador {
  id          String              @id @default(uuid())
  /// Valor que lleva el QR: COL-M-… (mercancía) o COL-U-… (ubicación).
  codigo      String              @unique
  tipo        IdentificadorTipo
  estado      IdentificadorEstado @default(ACTIVO)
  loteId      String?             @unique
  lote        Lote?               @relation(fields: [loteId], references: [id])
  ubicacionId String?             @unique
  ubicacion   Ubicacion?          @relation(fields: [ubicacionId], references: [id])
  creadoEn    DateTime            @default(now())
}

model Bodega {
  id          String      @id @default(uuid())
  codigo      String      @unique
  nombre      String
  zonas       Zona[]
  ubicaciones Ubicacion[]
}

model Zona {
  id          String      @id @default(uuid())
  bodegaId    String
  bodega      Bodega      @relation(fields: [bodegaId], references: [id])
  codigo      String
  nombre      String
  tipo        ZonaTipo
  ubicaciones Ubicacion[]

  @@unique([bodegaId, codigo])
}

/// RN-MAE-005 / RN-014: el código de ubicación es único dentro de la bodega.
model Ubicacion {
  id       String  @id @default(uuid())
  bodegaId String
  bodega   Bodega  @relation(fields: [bodegaId], references: [id])
  zonaId   String
  zona     Zona    @relation(fields: [zonaId], references: [id])
  codigo   String
  activa   Boolean @default(true)
  /// HU-BOD-002: capacidad en una unidad configurada. Sin capacidad = ilimitada y pendiente de configurar (HD-17 abierta).
  capacidad       Float?
  unidadCapacidad UnidadMedida?
  identificador   Identificador?

  @@unique([bodegaId, codigo])
}
